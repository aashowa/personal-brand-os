# Copy to .env and fill in what you use. Never commit .env.
# Scripts read these by name and never print them.

# Transcripts (whisper-1), covers and thumbnails (Kie.ai), teardowns and YouTube transcripts (Gemini)
OPENAI_API_KEY=
KIE_API_KEY=
GEMINI_API_KEY=

# HeyGen: leave HEYGEN_API_KEY unset. The heygen CLI signs in with OAuth (heygen auth login --oauth),
# and reel.py strips the key so renders bill your plan credits instead of API credits.

# YouTube Data API key (research) and OAuth app (uploads, analytics).
# The refresh token is written here by: python3 system/youtube_upload.py auth
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# GoHighLevel: private integration token + location (Social Planner, contacts).
# site/api/subscribe.js reads GHL_API_KEY, GHL_LOCATION_ID and LIBRARY_TAG from your Vercel project settings instead.
GHL_API_KEY=
GHL_LOCATION_ID=
LIBRARY_TAG=free-library

# Meta Graph API system-user token (Instagram insights, growth numbers, trial Reels)
META_ACCESS_TOKEN=

# Research: Apify (Instagram outliers), X cookies for twitter-cli (optional)
APIFY_API_TOKEN=
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
